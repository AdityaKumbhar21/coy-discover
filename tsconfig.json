{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@/server/*": ["./backend/src/*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "backend/scripts/**/*.ts",
    "backend/drizzle.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "frontend", "backend/dist"]
}
