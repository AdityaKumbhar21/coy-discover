{
  "name": "coy-discover",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.12",
  "engines": {
    "node": ">=24.22.3 <25",
    "pnpm": "11.28.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @coy/frontend --filter @coy/backend dev",
    "build": "pnpm --filter @coy/backend build && pnpm --filter @coy/frontend build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm --filter @coy/frontend typecheck && pnpm --filter @coy/backend typecheck && tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "pnpm --filter @coy/backend db:generate",
    "db:migrate": "pnpm --filter @coy/backend db:migrate",
    "db:seed": "pnpm --filter @coy/backend db:seed",
    "dev:frontend": "pnpm --filter @coy/frontend dev",
    "dev:backend": "pnpm --filter @coy/backend dev",
    "start:frontend": "pnpm --filter @coy/frontend start",
    "start:backend": "pnpm --filter @coy/backend start"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.4"
  }
}
